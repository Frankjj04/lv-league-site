{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/register",
      "destination": "/registro",
      "permanent": false
    },
    {
      "source": "/register.html",
      "destination": "/registro",
      "permanent": false
    },
    {
      "source": "/league",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/league.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/schedule",
      "destination": "/calendario",
      "permanent": false
    },
    {
      "source": "/schedule.html",
      "destination": "/calendario",
      "permanent": false
    },
    {
      "source": "/contact",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/contact.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/privacy",
      "destination": "/privacidad",
      "permanent": false
    },
    {
      "source": "/terms",
      "destination": "/terminos",
      "permanent": false
    },
    {
      "source": "/ref",
      "destination": "/arbitro",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        }
      ]
    }
  ]
}
